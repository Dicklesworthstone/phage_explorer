{
  "name": "@phage-explorer/web",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run prepare:db && bunx vite dev",
    "prepare:db": "bun run ../../scripts/build-web-db.ts --source public/phage.db --output public",
    "build": "bun run prepare:db && bunx vite build",
    "preview": "bunx vite preview",
    "lint": "bunx eslint src --max-warnings=0",
    "generate:og": "bun run scripts/generate-og-images.ts",
    "generate:icons": "bun run scripts/generate-icons.ts"
  },
  "dependencies": {
    "@react-spring/web": "^10.0.3",
    "@studio-freight/lenis": "^1.0.42",
    "@tanstack/react-query": "^5.104.1",
    "@use-gesture/react": "^10.3.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "comlink": "^4.4.2",
    "immer": "^11.1.21",
    "pako": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.13.0",
    "three": "^0.186.1",
    "web-vitals": "^6.2.2",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0"
  }
